# Copy to .env and fill in. Never commit the real file.
# Hedera operator for anchoring receipts + minting certificates (testnet for the bounty).
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.12345
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...
# JSON-RPC endpoint (Hashio) used by the contracts package.
HEDERA_RPC_URL=https://testnet.hashio.io/api
# Filled in after first deploy / setup run.
HEDERA_REGISTRY_ADDRESS=
# Live template HCS topic for NEW anchors. Leave empty to auto-create.
# NEVER set this to 0.0.10569989 (that topic is the frozen Window 9 exhibit).
HEDERA_TEMPLATE_TOPIC_ID=
# Legacy alias for HEDERA_TEMPLATE_TOPIC_ID (still honoured if TEMPLATE is unset).
HEDERA_PROVENANCE_TOPIC_ID=
# Read-only pointer to the frozen Window 9 exhibit topic (documentation / UI only).
HEDERA_EXHIBIT_TOPIC_ID=0.0.10569989
HEDERA_CERTIFICATE_TOKEN_ID=
